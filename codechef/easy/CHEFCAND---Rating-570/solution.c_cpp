#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , n , x ;
    cin >> t;
    for(int i=0;i<t;i++){
        cin >> n >> x;
        if(n < x) cout << "0";
        else if((n-x)%4 != 0) cout << (n-x)%4;
        else cout << (n-x)/4;
        cout << endl;
    }
}
