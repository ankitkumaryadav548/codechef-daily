#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , n ;
    cin >> t ;
    for(int i=0;i<t;i++){
        cin >> n;
        int res = 0;
        while(n > 0){
            int a = n%10;
            res = res*10+a;
            n = n/10;
        }
        cout << res;
        cout << endl;
    }
}
