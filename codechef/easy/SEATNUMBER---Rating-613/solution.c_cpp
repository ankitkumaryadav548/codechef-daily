#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , n ;
    cin >> t ;
    for(int i=0;i<t;i++){
        cin >> n ;
        if(n>=1 && n<=10) cout << "Lower Double";
        else if(n>=11 && n<=15) cout << "Lower Single";
        else if(n>=16 && n<=25) cout << "Upper Double";
        else cout << "Upper Single";
        cout << endl;
    }
}