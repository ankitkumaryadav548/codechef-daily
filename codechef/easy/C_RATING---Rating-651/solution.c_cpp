#include <bits/stdc++.h>
using namespace std;

int main() {
    int t, x, y;
    cin >> t;

    while(t--) {
        cin >> x >> y;

        int count = 0;

        while(x < y) {
            x = x + 8;
            count++;
        }

        cout << count << endl;
    }

    return 0;
}