#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , n , x , y ;
    cin >> t;
    for(int i=0;i<t;i++){
        cin >> n >> x >> y;
        if(y % x == 0 && (y / x) <= n) {
            cout << "YES\n";
        } else {
            cout << "NO\n";
        }
    }
}
