#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , a , b ;
    cin >> t ;
    for(int i=0;i<t;i++){
        cin >> a >> b ;
        int x = a/10;
        int y = b/20;
        if(x==y) cout << "ANY";
        else if(x>y) cout << "FIRST";
        else cout << "SECOND";
        cout << endl;
    }
}
