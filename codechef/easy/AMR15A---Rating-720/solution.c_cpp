#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n ;
    int arr[n];
    cin >> n;
    int count1 = 0;
    int count2 = 0;
    for(int i=0;i<n;i++){
            cin >> arr[i];
            if(arr[i]%2 == 0) count1++;
            else if(arr[i] %2 != 0) count2++;
    }
    if(count1>count2) cout << "Ready for battle";
    else cout << "Not Ready";
    cout << endl;
}
