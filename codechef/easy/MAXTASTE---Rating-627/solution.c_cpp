#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t, a, b, c, d;
    cin >> t;
    for (int i = 0; i < t; i++) {
        cin >> a >> b >> c >> d;
        if (a > b && c > d)
            cout << a + c;
        else if (a > b && d > c)
            cout << a + d;
        else if (b > a && c > d)
            cout << b + c;
        else
            cout << b + d;

        cout << endl;
    }
}