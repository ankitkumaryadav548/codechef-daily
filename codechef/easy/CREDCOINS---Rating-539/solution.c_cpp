#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , x , y;
    cin >> t;
    for(int i=0;i<t;i++){
        cin >> x >> y;
        int a = x*y;
        if(a>=100){
            cout << a/100;
        }
        else cout << "0";
        cout << endl;
    }
}
