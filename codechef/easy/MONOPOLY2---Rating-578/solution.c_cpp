#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , a ,b ,c ,d;
    cin>> t;
    for(int i=0;i<t;i++){
        cin >> a >> b >> c >> d;
        if(a>(b+c+d)|| b>(a+c+d)||c>(a+b+d)|| d>(a+b+c)) cout << "Yes";
        else cout << "No";
        cout << endl;
    }
}
