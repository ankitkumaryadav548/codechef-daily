#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t, n;
    cin >> t;
    for (int i = 0; i < t; i++) {
        cin >> n;
        int s = 0;
        int arr[n];
        for (int j = 0; j < n; j++) {
            cin >> arr[j];
            if (arr[j] >= 1000) s++;
        }
    cout << s << endl;
    }
}