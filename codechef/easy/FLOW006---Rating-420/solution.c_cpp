#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t , n ;
    cin >> t ;
    for(int i=0;i<t;i++){
        int sum = 0;
        cin >> n ;
        while(n>0){
            int a = n%10;
            sum  = sum + a ;
            n/=10;
        }
        cout << sum << endl;
    }
}
